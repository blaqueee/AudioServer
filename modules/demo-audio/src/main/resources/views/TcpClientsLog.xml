<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_7.4.xsd">

    <grid title="Online Tcp clients" name="tcp-clients-grid" model="com.axelor.apps.audio.dto.OnlineClientsDto"
          canSave="false" canEdit="false" canDelete="false" canNew="false">
        <field name="customOffice"/>
        <field name="status"/>
    </grid>

    <form title="Online Tcp client" name="tcp-clients-form" model="com.axelor.apps.audio.dto.OnlineClientsDto"
          canNew="false" canEdit="false" onNew="action-method-get-online-tcp-clients" onLoad="action-method-get-online-tcp-clients" canSave="false" canDelete="false">
        <panel readonly="true">
            <field name="$onlineClients" title="Online Tcp clients" widget="one-to-many" target="com.axelor.apps.audio.dto.OnlineClientsDto" colSpan="12"/>
        </panel>
    </form>

    <action-method name="action-method-get-online-tcp-clients">
        <call class="com.axelor.apps.audio.controller.OnlineClientsController" method="getTcpClients"/>
    </action-method>

</object-views>